# Generated and local-only artifacts. The root package is private, but `npm pack`
# is still useful as a packaging sanity check and should not bundle rendered output.
node_modules/
dist/
.agent-surface/
mcps/*/node_modules/
mcps/*/dist/
.DS_Store
*.log

# Private skill and retired command source; neither belongs in the package payload.
commands/ops-server.md
skills/ops-server/

# MCP credential files must never enter the package payload.
.env
.env.*
!.env.example

# Candidate source repositories stay in Git; package only registered runtime/index inputs.

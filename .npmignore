# Generated and local-only artifacts. The root package is private, but `npm pack`
# is still useful as a packaging sanity check and should not bundle rendered output.
node_modules/
dist/
.agent-surface/
mcps/*/node_modules/
mcps/*/dist/
.DS_Store
*.log

# Local-only command source (gitignored); keep it out of the pack payload too.
commands/ops-server.md

# MCP credential files must never enter the package payload.
.env
.env.*
!.env.example


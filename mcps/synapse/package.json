{
  "name": "synapse-mcp",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Local-first multi-agent memory + coordination MCP: one stdio server per session over shared node:sqlite files, plus a PostToolUse hook that delivers other agents' new records.",
  "license": "MIT",
  "bin": {
    "synapse-bridge": "dist/src/server.js",
    "synapse-hook": "dist/src/hook.js"
  },
  "scripts": {
    "prebuild": "node require-node.mjs",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "node require-node.mjs",
    "test": "tsc && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": ">=1.24.0 <2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "~22.17",
    "typescript": "~5.6"
  },
  "overrides": {
    "@hono/node-server": "2.1.5",
    "fast-uri": "3.1.9"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}

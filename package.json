{
  "name": "agent-surface",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-surface": "./scripts/agent-surface.mjs"
  },
  "scripts": {
    "inventory": "node scripts/agent-surface.mjs inventory",
    "build": "node scripts/agent-surface.mjs build",
    "check": "node scripts/agent-surface.mjs check",
    "check:commands": "node scripts/agent-surface.mjs check commands",
    "check:skills": "node scripts/agent-surface.mjs check skills",
    "check:generated": "node scripts/agent-surface.mjs check generated",
    "check:rules": "node scripts/agent-surface.mjs check rules",
    "check:subagents": "node scripts/agent-surface.mjs check subagents",
    "doctor": "node scripts/agent-surface.mjs doctor",
    "install:synapse": "sh mcps/synapse/install.sh",
    "install:grimoire": "sh mcps/grimoire/install.sh",
    "install:mcps": "npm run install:synapse && npm run install:grimoire",
    "test": "node tests/run.mjs",
    "snapshot": "node tests/run.mjs"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "dependencies": {
    "@decimalturn/toml-patch": "3.0.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsonc-parser": "3.3.1",
    "yaml": "2.9.0"
  },
  "overrides": {
    "fast-uri": "3.1.6"
  }
}
